# Copy to .env and load with `set -a && source .env && set +a` before running services locally.
# These mirror what the EKS env would inject via IRSA + ConfigMaps.

# Database (matches docker-compose postgres service)
DB_URL=jdbc:postgresql://localhost:5432/customer
DB_USER=bss
DB_PASSWORD=bss

# LocalStack endpoint for AWS SDK
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# EventBridge + SQS resources (created by deploy/localstack-init/01-bootstrap.sh)
EVENT_BUS_NAME=bss-dev-events
SQS_QUEUE_URL=http://localhost:4566/000000000000/bss-dev-billing-orders

SPRING_PROFILES_ACTIVE=local
