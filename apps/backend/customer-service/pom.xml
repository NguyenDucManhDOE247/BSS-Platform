<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Dọn nợ GĐ3: 3.2.12 → 3.5.16 (bản cuối dòng 3.5) — dọn ~34 CVE HIGH/CRITICAL mỗi image.
             Lần thử nâng trước "phá Flyway" (Unsupported Database: PostgreSQL 15.19) thật ra là do Flyway
             10+ TÁCH phần hỗ trợ Postgres ra artifact riêng flyway-database-postgresql — thêm vào là xong.
             Lịch sử 3.2.4 → 3.2.12: xem git log file này. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.bss</groupId>
    <artifactId>customer-service</artifactId>
    <version>0.1.0</version>
    <name>customer-service</name>
    <description>BSS Customer Management Service (TMF629)</description>

    <properties>
        <!-- Dọn nợ GĐ3 (CVE): Boot 3.5.16 là bản cuối dòng 3.5, không còn bản vá mới. Vá CVE còn lại (Trivy,
             mức HIGH + CRITICAL) bằng cách ghi đè version Boot quản lý, CHỈ nâng patch CÙNG dòng. Bỏ khi lên
             Boot 4.x (tự mang bản mới hơn). -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <tomcat.version>10.1.60</tomcat.version>
        <postgresql.version>42.7.12</postgresql.version>
        <java.version>21</java.version>
    </properties>

    <!--
      Giai đoạn 3, mục 6: đọc bss-common-java từ GitHub Packages thay vì mỗi service tự chép
      NotFoundException/GlobalExceptionHandler (B-15). GitHub Packages KHÔNG cho tải xuống ẩn
      danh dù repo là public — mọi request (kể cả `mvn verify` trong CI) đều cần header auth, nên
      `.github/workflows/ci-backend.yml` phải cấu hình `server-id: github` giống hệt workflow
      publish; chạy `mvn verify` trên máy cá nhân cần tự thêm 1 <server id="github"> vào
      ~/.m2/settings.xml với 1 Personal Access Token có quyền `read:packages`.
    -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/NguyenDucManhDOE247/BSS-Platform</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.bss</groupId>
            <artifactId>bss-common-java</artifactId>
            <version>0.1.0</version>
        </dependency>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Giai đoạn 9 (ADR-008 quyết định 4): service TỰ kiểm JWT của Keycloak (zero-trust),
             không tin header do gateway chèn. Bật/tắt bằng bss.auth.enabled — xem SecurityConfig. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema migrations -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
            <!-- Flyway 10+ (Boot 3.3+): hỗ trợ từng DB là module riêng — thiếu là "Unsupported Database". -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
            </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Observability: Actuator exposes /actuator/health and /actuator/prometheus -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- jwt() của MockMvc: giả lập token đã kiểm xong, KHÔNG mock framework (CLAUDE.md §9) —
             bộ lọc Spring Security thật vẫn chạy và áp luật phân quyền thật. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Giai đoạn 7 (B-17): JSON structured logging. Not managed by spring-boot-dependencies
             BOM — version pinned explicitly. 7.4 is the latest release compatible with the
             Logback 1.4.x line that Boot 3.2.12 brings in (8.x needs Logback 1.5+ / Boot 3.4+). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- B-09: surefire (mvn test) only picks up *Test/*Tests by convention; our
                 Testcontainers integration tests are named *IT on purpose, and only
                 failsafe (bound to `mvn verify`) runs those. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
