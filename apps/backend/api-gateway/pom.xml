<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Dọn nợ GĐ3: 3.2.12 → 3.5.16 (bản cuối dòng 3.5) — dọn ~34 CVE HIGH/CRITICAL mỗi image.
             Lần thử nâng trước "phá Flyway" (Unsupported Database: PostgreSQL 15.19) thật ra là do Flyway
             10+ TÁCH phần hỗ trợ Postgres ra artifact riêng flyway-database-postgresql — thêm vào là xong.
             Lịch sử 3.2.4 → 3.2.12: xem git log file này. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.bss</groupId>
    <artifactId>api-gateway</artifactId>
    <version>0.1.0</version>
    <name>api-gateway</name>
    <description>BSS API Gateway — routing, auth, rate limiting</description>

    <properties>
        <!-- Dọn nợ GĐ3 (CVE): Boot 3.5.16 là bản cuối dòng 3.5, không còn bản vá mới. Vá CVE còn lại (Trivy,
             mức HIGH + CRITICAL) bằng cách ghi đè version Boot quản lý, CHỈ nâng patch CÙNG dòng. Bỏ khi lên
             Boot 4.x (tự mang bản mới hơn). -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <netty.version>4.1.138.Final</netty.version>
        <java.version>21</java.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version> <!-- dòng tương thích Boot 3.5 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Giai đoạn 7: CVE-2026-8763 (CRITICAL) + CVE-2026-13506 (HIGH) mới xuất hiện trong
                 CVE DB của Trivy nhắm vào bcprov-jdk18on:1.78 (kéo vào transitive bởi
                 spring-security-rsa, dùng cho JWK RSA — `mvn dependency:tree` xác nhận, không
                 phải do dependency nào Giai đoạn 7 thêm). Khác các CVE khác trong .trivyignore
                 (cần nâng cả dòng Spring Boot mới có bản vá) — bcprov là 1 lá riêng biệt, nâng
                 thẳng lên 1.85 (bản đã vá theo advisory) không đụng gì tới Spring/Spring Cloud. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.86</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Giai đoạn 7, việc 6 (B-18): xác thực JWT ở gateway. -resource-server kéo theo
             spring-security-core; thêm cả 2 starter tường minh cho dễ đọc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Giai đoạn 7 (B-17): JSON structured logging — xem comment đầy đủ ở customer-service/pom.xml. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
