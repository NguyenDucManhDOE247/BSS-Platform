<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Dọn nợ GĐ3: 3.2.12 → 3.5.16 (bản cuối dòng 3.5) — dọn ~34 CVE HIGH/CRITICAL mỗi image.
             Lần thử nâng trước "phá Flyway" (Unsupported Database: PostgreSQL 15.19) thật ra là do Flyway
             10+ TÁCH phần hỗ trợ Postgres ra artifact riêng flyway-database-postgresql — thêm vào là xong.
             Lịch sử 3.2.4 → 3.2.12: xem git log file này. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.bss</groupId>
    <artifactId>order-management</artifactId>
    <version>0.1.0</version>
    <name>order-management</name>
    <description>BSS Order Management (TMF622) — publishes domain events to EventBridge</description>
    <properties>
        <!-- Dọn nợ GĐ3 (CVE): Boot 3.5.16 là bản cuối dòng 3.5, không còn bản vá mới. Vá CVE còn lại (Trivy,
             mức HIGH + CRITICAL) bằng cách ghi đè version Boot quản lý, CHỈ nâng patch CÙNG dòng. Bỏ khi lên
             Boot 4.x (tự mang bản mới hơn). -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <netty.version>4.1.138.Final</netty.version>
        <tomcat.version>10.1.60</tomcat.version>
        <postgresql.version>42.7.12</postgresql.version>
        <java.version>21</java.version>
        <aws.sdk.version>2.55.11</aws.sdk.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- Same fix as billing-service/pom.xml: AWS SDK 2.54.x's default sync HTTP client
             needs a recent httpclient5 (TlsSocketStrategy, added in 5.3) that
             spring-boot-starter-parent's own BOM would otherwise pin down to 5.2.3, since the
             parent POM wins Maven's dependency mediation over the imported AWS SDK BOM. -->
        <httpclient5.version>5.6.4</httpclient5.version>
        <httpcore5.version>5.4.3</httpcore5.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <!-- B-15: bss-common-java từ GitHub Packages (cần auth kể cả repo public) — giải thích đầy đủ ở
         customer-service/pom.xml; Dockerfile nhận token qua BuildKit secret. -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/NguyenDucManhDOE247/BSS-Platform</url>
        </repository>
    </repositories>
    <dependencies>
        <!-- B-15: exception handler, phân trang, CurrentCaller, UUID v7 — thay bản sao riêng của service. -->
        <dependency><groupId>com.bss</groupId><artifactId>bss-common-java</artifactId><version>0.2.0</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <!-- Giai đoạn 9 (ADR-008 quyết định 4): service tự kiểm JWT — xem config/SecurityConfig. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-oauth2-resource-server</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <!-- AOP proxying is what makes @CircuitBreaker/@Retry (below) actually intercept calls. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-aop</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency> <!-- Flyway 10+: hỗ trợ Postgres là module riêng -->
        <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
        <!-- AWS SDK: EventBridge publisher -->
        <dependency><groupId>software.amazon.awssdk</groupId><artifactId>eventbridge</artifactId></dependency>
        <!-- B-19: IRSA on EKS uses WebIdentityTokenFileCredentialsProvider, which requires the
             `sts` module on the classpath even though we never call STS ourselves. Without it,
             DefaultCredentialsProvider silently falls through to the node's credentials (or
             none) instead of assuming the pod's IAM role — LocalStack never catches this
             because it uses static test/test credentials regardless. -->
        <dependency><groupId>software.amazon.awssdk</groupId><artifactId>sts</artifactId></dependency>
        <!-- B-13: order-management calls product-catalog over REST for authoritative price;
             Resilience4j adds retry + circuit breaker around that call. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-testcontainers</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>localstack</artifactId><scope>test</scope></dependency>
        <!-- Giai đoạn 7 (B-17): JSON structured logging — xem comment đầy đủ ở customer-service/pom.xml. -->
        <dependency><groupId>net.logstash.logback</groupId><artifactId>logstash-logback-encoder</artifactId><version>7.4</version></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
            <!-- B-09: surefire (the `test` phase) only runs *Test/*Tests by convention. Our
                 integration tests are named *IT on purpose (Testcontainers, slower, need
                 Docker) — failsafe is the plugin that actually picks those up, bound to the
                 `verify` phase so `mvn verify` (not just `mvn test`) is what proves them green. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
