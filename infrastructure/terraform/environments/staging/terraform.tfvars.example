owner_email = "you@example.com"

# EKS public endpoint = ONLY the operator's IP(s). CD no longer needs this open: cd-staging's deploy job runs on a
# CodeBuild runner inside the VPC and reaches the API server through the private endpoint (ADR-013,
# docs/runbooks/cd-runner.md). Your own IP: curl -s https://checkip.amazonaws.com
public_access_cidrs = ["1.2.3.4/32"]

# ADR-006: true = destroyable environment (no deletion protection, secrets deleted immediately).
ephemeral = true
