owner_email = "you@example.com"

# EKS public endpoint = ONLY the operator's IP(s). CD no longer needs this open: cd-prod's deploy job runs on a
# CodeBuild runner inside the VPC and reaches the API server through the private endpoint (ADR-013,
# docs/runbooks/cd-runner.md). Your own IP: curl -s https://checkip.amazonaws.com
public_access_cidrs = ["1.2.3.4/32", "5.6.7.0/24"]

# ADR-006: true = destroyable (demo). Leave false (default) for any prod whose data matters.
ephemeral = true
