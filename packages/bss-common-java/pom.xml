<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bss</groupId>
    <artifactId>bss-common-java</artifactId>
    <!--
      0.2.0 (2026-10-01, B-15): UuidV7 + UuidV7Generator (PK UUID v7), OffsetPageRequest (4 bản sao giống
      hệt ở 4 service), CurrentCaller (danh tính người gọi từ JWT — 3 bản gần giống ở customer/order/billing).
    -->
    <version>0.2.0</version>
    <packaging>jar</packaging>
    <name>bss-common-java</name>
    <description>Shared Java code for BSS backend services: exceptions, paging, identity, ids</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
      Mọi phiên bản lấy từ ĐÚNG BOM của Spring Boot mà các service dùng làm parent (3.5.16). Mọi dependency
      bên dưới là `provided`: lúc chạy, service dùng bản của chính nó — ở đây chỉ để biên dịch + test. Lệch
      bản giữa thư viện và service = biên dịch được ở đây nhưng NoSuchMethodError ở service (0.1.0 từng ghim
      tay Spring 6.1.5 từ thời Boot 3.2 trong khi service đã lên 6.2). Nâng Boot ở service ⇒ nâng dòng này.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.5.16</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ProblemDetail (RFC 7807), ResponseStatusException -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
          Real bug found by actually running `mvn install` here for the first time (this module
          was never built on its own before — no service depended on it yet, see B-15): spring-web
          alone is NOT enough. MethodArgumentNotValidException (spring-web) exposes
          getBindingResult(): BindingResult, but BindingResult/Errors themselves live in
          spring-context, not spring-web — compiling this class needs both.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- DataIntegrityViolationException (org.springframework.dao) lives in spring-tx -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- OffsetPageRequest implements org.springframework.data.domain.Pageable -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- CurrentCaller đọc JwtAuthenticationToken (resource server) + Jwt (jose) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-resource-server</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- UuidV7Generator implements org.hibernate.id.uuid.UuidValueGenerator -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Ghim surefire: bản mặc định của Maven quá cũ với JUnit 5 → `mvn verify` có thể xanh mà 0 test (B-09). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
        </plugins>
    </build>

    <!--
      Giai đoạn 3, mục 6 (tùy chọn): publish lên GitHub Packages thay vì mỗi service tự chép
      (bss-common-java trước đây KHÔNG được service nào dùng — xem B-15). `distributionManagement`
      trỏ đúng registry Maven của GitHub Packages cho repo này; `.github/workflows/
      publish-bss-common-java.yml` là nơi thực sự chạy `mvn deploy` (cần packages: write + auth
      GITHUB_TOKEN, chỉ có trong Actions — không chạy `mvn deploy` tay từ máy local).
      ⚠️ GitHub Packages KHÔNG cho ghi đè 1 version đã publish — mỗi lần đổi code ở đây phải bump
      <version> ở trên trước khi merge vào main, nếu không workflow publish sẽ báo lỗi 409.
    -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — bss-platform</name>
            <url>https://maven.pkg.github.com/NguyenDucManhDOE247/BSS-Platform</url>
        </repository>
    </distributionManagement>
</project>
