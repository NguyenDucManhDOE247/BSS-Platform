<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bss</groupId>
    <artifactId>bss-common-java</artifactId>
    <!-- 0.2.0 (2026-10-01, B-15): thêm com.bss.common.id.UuidV7 + UuidV7Generator (PK UUID v7). -->
    <version>0.2.0</version>
    <packaging>jar</packaging>
    <name>bss-common-java</name>
    <description>Shared Java code for BSS backend services: DTOs, exceptions, security, AWS helpers</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Khớp đúng bản mà Spring Boot 3.5.16 (parent của mọi service) quản lý. Tất cả là `provided`:
          lúc chạy, service dùng bản của chính nó — ở đây chỉ để biên dịch, nên lệch bản = rủi ro biên dịch
          được ở đây nhưng NoSuchMethodError ở service (0.1.0 từng ghim Spring 6.1.5 từ thời Boot 3.2).
        -->
        <spring.version>6.2.19</spring.version>
        <hibernate.version>6.6.53.Final</hibernate.version>
        <junit.version>5.12.2</junit.version>
    </properties>

    <dependencies>
        <!-- ProblemDetail (RFC 7807) responses, validation -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          Real bug found by actually running `mvn install` here for the first time (this module
          was never built on its own before — no service depended on it yet, see B-15): spring-web
          alone is NOT enough. MethodArgumentNotValidException (spring-web) exposes
          getBindingResult(): BindingResult, but BindingResult/Errors themselves live in
          spring-context, not spring-web — compiling this class needs both.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- DataIntegrityViolationException (org.springframework.dao) lives in spring-tx -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- UuidV7Generator implements org.hibernate.id.uuid.UuidValueGenerator (B-15) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Ghim surefire: bản mặc định của Maven quá cũ với JUnit 5 → `mvn verify` có thể xanh mà 0 test (B-09). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
        </plugins>
    </build>

    <!--
      Giai đoạn 3, mục 6 (tùy chọn): publish lên GitHub Packages thay vì mỗi service tự chép
      (bss-common-java trước đây KHÔNG được service nào dùng — xem B-15). `distributionManagement`
      trỏ đúng registry Maven của GitHub Packages cho repo này; `.github/workflows/
      publish-bss-common-java.yml` là nơi thực sự chạy `mvn deploy` (cần packages: write + auth
      GITHUB_TOKEN, chỉ có trong Actions — không chạy `mvn deploy` tay từ máy local).
      ⚠️ GitHub Packages KHÔNG cho ghi đè 1 version đã publish — mỗi lần đổi code ở đây phải bump
      <version> ở trên trước khi merge vào main, nếu không workflow publish sẽ báo lỗi 409.
    -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — bss-platform</name>
            <url>https://maven.pkg.github.com/NguyenDucManhDOE247/BSS-Platform</url>
        </repository>
    </distributionManagement>
</project>
